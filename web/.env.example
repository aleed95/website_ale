# ─────────────────────────────────────────────────────────────
# Website (Astro) — copy to web/.env for local development.
# On Netlify, set the same keys under Site configuration → Environment variables.
# None of these are exposed to the browser: they are read at build time only.
# ─────────────────────────────────────────────────────────────

# Sanity project ID (sanity.io/manage → project → "Project ID"). Not secret.
SANITY_PROJECT_ID=

# Dataset name. Default: production
SANITY_DATASET=production

# Sanity API version (a date). Pin it; bump deliberately after reading the changelog.
SANITY_API_VERSION=2026-11-01

# OPTIONAL — only needed if the dataset is private (or for future draft previews).
# Create a token with the "Viewer" role. This is a SECRET: never commit it, never
# prefix it with PUBLIC_.
SANITY_API_READ_TOKEN=

# Public URL of the website, without a trailing slash. Used for canonical URLs,
# Open Graph and the sitemap. On Netlify it falls back to the built-in URL variable.
SITE_URL=http://localhost:4321
