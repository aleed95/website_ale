---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import ContactForm from '@/components/content/ContactForm.astro';
import { getRouteAlternates, type Locale } from '@/i18n/config';
import { t } from '@/i18n/ui';
import { getPagePath } from '@/lib/links';
import { getSectionMeta } from '@/lib/sections';
import { useSanity } from '@/lib/sanity/fetch';
import { socialLabel } from '@/lib/social';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const sanity = useSanity(Astro.locals);
const strings = t(locale);
const [meta, settings, sections] = await Promise.all([
  getSectionMeta(sanity, 'contact', locale),
  sanity.getSiteSettings(locale),
  sanity.getSectionPages(locale),
]);
const socialLinks = (settings?.socialLinks ?? []).filter((link) => link.url);
const privacyHref = settings?.privacyPageSlug ? getPagePath(locale, settings.privacyPageSlug) : undefined;
---

<BaseLayout
  title={meta.seo.title}
  description={meta.seo.description}
  image={meta.seo.image}
  noindex={meta.seo.noindex}
  locale={locale}
  alternates={getRouteAlternates('contact')}
>
  <PageHeader title={meta.title} intro={meta.intro} />

  <Container class="contact-layout">
    <dl class="details">
      {
        settings?.email && (
          <div>
            <dt>{strings.contact.email}</dt>
            <dd><a href={`mailto:${settings.email}`}>{settings.email}</a></dd>
          </div>
        )
      }
      {
        settings?.phone && (
          <div>
            <dt>{strings.contact.phone}</dt>
            <dd><a href={`tel:${settings.phone.replace(/[^\d+]/g, '')}`}>{settings.phone}</a></dd>
          </div>
        )
      }
      {
        settings?.address && (
          <div>
            <dt>{strings.contact.address}</dt>
            <dd class="address">{settings.address}</dd>
          </div>
        )
      }
      {
        socialLinks.length > 0 && (
          <div>
            <dt>{strings.contact.social}</dt>
            <dd>
              <ul role="list" class="social">
                {socialLinks.map((link) => (
                  <li>
                    <a href={link.url} rel="noopener me">{socialLabel(link)}</a>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        )
      }
    </dl>

    <ContactForm locale={locale} title={sections?.contactForm?.formTitle} privacyHref={privacyHref} />
  </Container>
</BaseLayout>

<style>
  :global(.contact-layout) {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
    padding-bottom: var(--space-3xl);
  }

  @media (min-width: 60rem) {
    :global(.contact-layout) {
      grid-template-columns: 1fr 2fr;
      gap: var(--space-2xl);
    }
  }

  .details {
    display: grid;
    gap: var(--space-l);
  }

  dt {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-heading-alt);
  }

  dd {
    margin: var(--space-3xs) 0 0;
    font-size: var(--text-lg);
    overflow-wrap: anywhere;
  }

  .address {
    white-space: pre-line;
  }

  .social {
    display: grid;
    gap: var(--space-3xs);
  }
</style>
