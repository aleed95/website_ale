---
/** "Page not found" (static 404 page and missing on-demand articles). */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import { getRoutePath } from '@/i18n/config';
import { t } from '@/i18n/ui';

// A single static 404 serves both languages: Italian first, English below.
const it = t('it').notFound;
const en = t('en').notFound;
---

<BaseLayout title={it.title} locale="it" noindex>
  <Container as="section" class="not-found">
    <p class="eyebrow">404</p>
    <h1>{it.title}</h1>
    <p class="lead">{it.text}</p>
    <div><Button href={getRoutePath('home', 'it')}>{it.backHome}</Button></div>
    <div lang="en" class="en">
      <h2>{en.title}</h2>
      <p>{en.text}</p>
      <p><a href={getRoutePath('home', 'en')}>{en.backHome}</a></p>
    </div>
  </Container>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    gap: var(--space-m);
    padding-block: var(--space-3xl);
  }

  .en {
    display: grid;
    gap: var(--space-2xs);
    margin-top: var(--space-l);
    padding-top: var(--space-l);
    border-top: 1px solid var(--color-border);
  }

  .en h2 {
    font-size: var(--text-xl);
  }
</style>
