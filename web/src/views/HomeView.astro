---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import Emphasis from '@/components/ui/Emphasis.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import SanityImage from '@/components/content/SanityImage.astro';
import ProjectCard from '@/components/content/ProjectCard.astro';
import LatestArticles from '@/components/content/LatestArticles.astro';
import PublicationItem from '@/components/content/PublicationItem.astro';
import Pictogram from '@/assets/brand/pittogramma-verde-arancio.svg';
import PictogramLight from '@/assets/brand/pittogramma-beige-arancio.svg';
import Figure from '@/components/content/Figure.astro';
import { getRouteAlternates, getRoutePath, type Locale } from '@/i18n/config';
import { t } from '@/i18n/ui';
import { buildSeo } from '@/lib/seo';
import { useSanity } from '@/lib/sanity/fetch';
import { HOME_QUERY } from '@/lib/sanity/queries';
import { siteFallback } from '@/lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const sanity = useSanity(Astro.locals);
const strings = t(locale);
const [{ page, services }, settings] = await Promise.all([
  sanity.client.fetch(HOME_QUERY, { language: locale }),
  sanity.getSiteSettings(locale),
]);

const siteName = settings?.siteName || siteFallback.name;
const seo = buildSeo({
  title: siteName,
  seo: page?.seo,
  description: page?.heroText,
  image: page?.heroImage,
  settings,
});
const featuredProjects = (page?.featuredProjects ?? []).filter((p) => p !== null);
const featuredPublications = (page?.featuredPublications ?? []).filter((p) => p !== null);
const contactLabel = page?.ctaLabel || strings.nav.contact;
const servicesPath = getRoutePath('services', locale);
const pillars = page?.pillars ?? [];
const numbers = page?.numbers ?? [];
const manifesto = page?.manifesto?.quote ? page.manifesto : null;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  image={seo.image}
  imageAlt={seo.imageAlt}
  noindex={seo.noindex}
  locale={locale}
  alternates={getRouteAlternates('home')}
>
  {/* ── Hero: text + large photograph ─────────────────────────────── */}
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-media">
      {
        page?.heroImage?.asset ? (
          <SanityImage
            image={page.heroImage}
            sizes="(min-width: 60rem) 58vw, 100vw"
            widths={[640, 960, 1280, 1600, 2000, 2400]}
            priority
            edit={{ id: `homePage-${locale}`, type: 'homePage', path: 'heroImage' }}
          />
        ) : (
          <div class="hero-placeholder" aria-hidden="true" />
        )
      }
    </div>
    <div class="hero-text">
      {page?.heroEyebrow && <p class="eyebrow">{page.heroEyebrow}</p>}
      <h1 id="hero-title"><Emphasis text={page?.heroTitle || siteName} /></h1>
      {page?.heroText && <p class="lead">{page.heroText}</p>}
      <div class="hero-actions">
        <Button href={getRoutePath('contact', locale)}>{contactLabel}</Button>
        {services.length > 0 && (
          <Button href={servicesPath} variant="secondary">
            {strings.home.allServices}
          </Button>
        )}
      </div>
      <a href="#esplora" class="scroll-cue">
        {strings.common.discover}
        <span class="scroll-cue-arrow" aria-hidden="true">↓</span>
      </a>
    </div>
  </section>

  <div id="esplora" class="anchor-target" tabindex="-1"></div>

  {/* ── Three areas of work (brand payoff) ────────────────────────── */}
  {
    pillars.length > 0 && (
      <section class="section section--alt pillars-section" aria-labelledby="pillars-title">
        <Container>
          <div class="pillars-heading reveal">
            {/* Pictogram: recurring graphic element (brand manual p.03), ≥ 32px. */}
            <Pictogram class="mark" aria-hidden="true" focusable="false" />
            {settings?.tagline && <p class="eyebrow">{settings.tagline}</p>}
            <h2 id="pillars-title">
              <Emphasis text={page?.pillarsTitle || settings?.tagline || siteName} />
            </h2>
          </div>
          <ol role="list" class="pillars">
            {pillars.map((pillar) => (
              <li class="pillar reveal">
                <h3>{pillar.title}</h3>
                <p>{pillar.text}</p>
              </li>
            ))}
          </ol>
        </Container>
      </section>
    )
  }

  {/* ── Short introduction ────────────────────────────────────────── */}
  {
    (page?.introTitle || page?.introText) && (
      <section class="section" aria-labelledby="intro-title">
        <Container class="intro reveal">
          <div>
            <p class="eyebrow">{strings.nav.about}</p>
            <h2 id="intro-title">
              <Emphasis text={page?.introTitle || strings.nav.about} />
            </h2>
          </div>
          <div class="intro-text">
            {page?.introText && <p class="lead">{page.introText}</p>}
            <p>
              <a href={getRoutePath('about', locale)} class="arrow-link">
                {strings.common.readMore}
              </a>
            </p>
          </div>
        </Container>
      </section>
    )
  }

  {/* ── Services overview ─────────────────────────────────────────── */}
  {
    services.length > 0 && (
      <section class="section" aria-labelledby="services-title">
        <Container>
          <SectionHeading id="services-title" label={strings.nav.services} title={page?.servicesTitle} href={servicesPath} linkLabel={strings.home.allServices} />
          <ol role="list" class="services">
            {services.map((service, index) => (
              <li class="card service">
                <span class="service-number" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3 class="title">
                  <a href={`${servicesPath}#${service.slug}`}>
                    <Emphasis text={service.title} />
                  </a>
                </h3>
                <p>{service.summary}</p>
              </li>
            ))}
          </ol>
        </Container>
      </section>
    )
  }

  {/* ── Full-width photograph ─────────────────────────────────────── */}
  {
    page?.bandImage?.asset && (
      <section class="band" aria-label={page.bandImage.caption || page.bandImage.alt || ''}>
        <Figure
          image={page.bandImage}
          aspectRatio={21 / 9}
          sizes="100vw"
          class="band-figure"
          edit={{ id: `homePage-${locale}`, type: 'homePage', path: 'bandImage' }}
        />
      </section>
    )
  }

  {/* ── Selected projects ─────────────────────────────────────────── */}
  {
    featuredProjects.length > 0 && (
      <section class="section" aria-labelledby="projects-title">
        <Container>
          <SectionHeading
            id="projects-title"
            label={strings.nav.projects}
            title={page?.projectsTitle}
            href={getRoutePath('projects', locale)}
            linkLabel={strings.home.allProjects}
          />
          <ul role="list" class="card-grid">
            {featuredProjects.map((project) => (
              <li>
                <ProjectCard project={project} locale={locale} headingLevel="h3" />
              </li>
            ))}
          </ul>
        </Container>
      </section>
    )
  }

  {/* ── Numbers and manifesto (dark band) ────────────────────────── */}
  {
    (numbers.length > 0 || manifesto) && (
      <section class="manifesto-band" aria-label={manifesto?.attribution || strings.nav.about}>
        <Container class="manifesto-inner">
          {numbers.length > 0 && (
            <dl class="numbers">
              {numbers.map((item) => (
                <div class="number reveal">
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))}
            </dl>
          )}
          {manifesto && (
            <figure class="manifesto reveal">
              {/* On Charcoal Brown: Cornsilk + Burnt Caramel version (brand manual p.08). */}
              <PictogramLight class="mark" aria-hidden="true" focusable="false" />
              <blockquote>
                <p>{manifesto.quote}</p>
              </blockquote>
              {manifesto.attribution && <figcaption>{manifesto.attribution}</figcaption>}
            </figure>
          )}
        </Container>
      </section>
    )
  }

  {/* ── Latest articles: server island, so new articles appear without a deploy.
       In the Studio preview it renders inline, with drafts. ─────────────────── */}
  {
    sanity.preview ? (
      <LatestArticles locale={locale} title={page?.articlesTitle} />
    ) : (
      <LatestArticles server:defer locale={locale} title={page?.articlesTitle} />
    )
  }

  {/* ── Selected publications ─────────────────────────────────────── */}
  {
    featuredPublications.length > 0 && (
      <section class="section" aria-labelledby="publications-title">
        <Container>
          <SectionHeading
            id="publications-title"
            label={strings.nav.publications}
            title={page?.publicationsTitle}
            href={getRoutePath('publications', locale)}
            linkLabel={strings.home.allPublications}
          />
          <div class="publications">
            {featuredPublications.map((publication) => (
              <PublicationItem publication={publication} locale={locale} />
            ))}
          </div>
        </Container>
      </section>
    )
  }

  {/* ── Contact call to action ────────────────────────────────────── */}
  {
    page?.ctaTitle && (
      <section class="section" aria-labelledby="cta-title">
        <Container>
          <div class="cta reveal">
            <div class="cta-text">
              <p class="eyebrow">{strings.nav.contact}</p>
              <h2 id="cta-title">
                <Emphasis text={page.ctaTitle} />
              </h2>
              {page.ctaText && <p class="lead">{page.ctaText}</p>}
              <div>
                <Button href={getRoutePath('contact', locale)}>{contactLabel}</Button>
              </div>
            </div>
            <Pictogram class="cta-pictogram" aria-hidden="true" focusable="false" />
          </div>
        </Container>
      </section>
    )
  }
</BaseLayout>

<style>
  /* Hero ------------------------------------------------------------------ */
  .hero {
    display: grid;
  }

  .hero-media {
    overflow: hidden;
  }

  .hero-media :global(img),
  .hero-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  /* Gentle parallax: the photo moves slower than the page while the hero scrolls away. */
  @keyframes hero-parallax {
    from {
      transform: scale(1.08) translateY(0);
    }
    to {
      transform: scale(1.08) translateY(7%);
    }
  }

  @keyframes hero-text-out {
    to {
      opacity: 0.2;
      transform: translateY(-2rem);
    }
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-media :global(img) {
        animation-name: hero-parallax;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }

    }
  }

  /* Desktop only: on mobile the text sits below the photo and must stay readable. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 60rem) {
      .hero-text > :not(.scroll-cue) {
        animation-name: hero-text-out;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 10vh 90vh;
      }
    }
  }

  /* "Scopri ↓" — invitation to scroll to the first section. */
  .scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    justify-self: start;
    min-height: 2.75rem;
    margin-top: var(--space-s);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-heading-alt);
  }

  .scroll-cue-arrow {
    display: inline-block;
    font-size: var(--text-base);
  }

  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue-arrow {
      animation: nudge 2.4s var(--ease-out) infinite;
    }
  }

  @keyframes nudge {
    0%, 60%, 100% {
      transform: translateY(0);
    }
    30% {
      transform: translateY(5px);
    }
  }

  .anchor-target {
    scroll-margin-top: var(--header-height);
  }

  .anchor-target:focus {
    outline: none;
  }

  .hero-placeholder {
    background: linear-gradient(135deg, var(--color-surface-sage), var(--color-surface-sky));
  }

  .hero-text {
    display: grid;
    gap: var(--space-m);
    align-content: center;
    padding: var(--space-xl) var(--gutter) var(--space-2xl);
  }

  .hero-text h1 {
    max-width: 14ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-2xs);
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: 5fr 7fr;
      min-height: min(calc(100svh - var(--header-height)), 52rem);
    }

    .hero-media {
      order: 2;
    }

    .hero-media :global(img),
    .hero-placeholder {
      height: 100%;
      aspect-ratio: auto;
    }

    /* Align the text with the page container on wide screens. */
    .hero-text {
      padding-block: var(--space-2xl);
      padding-left: max(var(--gutter), calc((100vw - var(--container-max)) / 2));
      padding-right: var(--space-xl);
    }
  }

  /* Intro ----------------------------------------------------------------- */
  .section :global(.intro) {
    display: grid;
    gap: var(--space-m) var(--space-2xl);
  }

  @media (min-width: 60rem) {
    .section :global(.intro) {
      grid-template-columns: 2fr 3fr;
      align-items: start;
    }
  }

  .intro-text {
    display: grid;
    gap: var(--space-m);
  }

  .section :global(.intro) h2 {
    margin-top: var(--space-2xs);
  }

  /* Pillars (three areas) ------------------------------------------------- */
  .pillars-heading {
    display: grid;
    justify-items: center;
    gap: var(--space-s);
    margin-bottom: var(--space-xl);
    text-align: center;
  }

  .pillars-heading h2 {
    max-width: 22ch;
  }

  /* Pictogram: min. 32px on screen; clear space ≈ 1/6 of its height (manual p.04). */
  .mark {
    width: 3.5rem;
    height: auto;
    margin-bottom: var(--space-2xs);
  }

  .pillars {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 48rem) {
    .pillars {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
    }

    .pillar + .pillar {
      border-left: 1px solid var(--color-border);
    }
  }

  .pillar {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
    padding: var(--space-s) var(--space-l);
    text-align: center;
  }

  .pillar h3 {
    font-size: var(--text-2xl);
    font-style: italic;
    color: var(--color-heading-alt);
  }

  /* Services: occasional Dry Sage / Pale Sky cards (manual p.09) -------------- */
  .services {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }

  .service {
    padding: var(--space-m);
    border-radius: var(--radius-m);
    background-color: var(--color-surface-sage);
  }

  .service:nth-child(even) {
    background-color: var(--color-surface-sky);
  }

  /* Large Fraunces numerals (manual p.10). On Dry Sage: Charcoal Brown (6.3:1);
     on Pale Sky: Ebony (5.2:1) — Burnt Caramel would be too faint on both. */
  .service-number {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    line-height: 1;
    color: var(--palette-charcoal-brown);
  }

  .service:nth-child(even) .service-number {
    color: var(--palette-ebony);
  }

  .service :global(.title a),
  .service p {
    color: var(--palette-charcoal-brown);
  }

  /* Full-width photo band --------------------------------------------------- */
  .band :global(.band-figure) {
    gap: var(--space-xs);
  }

  .band :global(.band-figure img) {
    max-height: 75vh;
    object-fit: cover;
    border-radius: 0;
  }

  .band :global(.band-figure figcaption) {
    padding-inline: var(--gutter);
    max-width: calc(var(--container-max) + 2 * var(--gutter));
    margin-inline: auto;
    width: 100%;
  }

  /* Numbers + manifesto: Charcoal Brown band with Cornsilk text (12.7:1) ------ */
  .manifesto-band {
    padding-block: var(--space-2xl);
    background-color: var(--color-bg-inverse);
    color: var(--color-text-inverse);
  }

  .manifesto-band :global(.manifesto-inner) {
    display: grid;
    gap: var(--space-2xl);
  }

  .numbers {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
  }

  .number {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-2xs);
    padding-top: var(--space-s);
    border-top: 1px solid color-mix(in srgb, var(--color-text-inverse) 25%, transparent);
  }

  .number dd {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    line-height: 1;
    color: var(--color-text-inverse);
  }

  .number dt {
    font-size: var(--text-sm);
  }

  .manifesto {
    display: grid;
    justify-items: center;
    gap: var(--space-m);
    max-width: 48rem;
    margin-inline: auto;
    text-align: center;
  }

  .manifesto blockquote p {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-style: italic;
    line-height: var(--leading-snug);
    color: var(--color-text-inverse);
    text-wrap: balance;
  }

  .manifesto blockquote p::before {
    content: '«';
  }

  .manifesto blockquote p::after {
    content: '»';
  }

  .manifesto figcaption {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  /* Publications ---------------------------------------------------------- */
  .publications {
    max-width: 52rem;
  }

  /* Call to action -------------------------------------------------------- */
  .cta {
    position: relative;
    display: grid;
    gap: var(--space-l);
    align-items: center;
    overflow: hidden;
    padding: var(--space-xl) var(--space-l);
    background-color: var(--color-bg-alt);
    border-radius: var(--radius-m);
  }

  @media (min-width: 48rem) {
    .cta {
      grid-template-columns: 1fr auto;
      padding: var(--space-2xl) var(--space-xl);
    }
  }

  .cta-text {
    display: grid;
    gap: var(--space-m);
    max-width: 40rem;
  }

  .cta-pictogram {
    width: clamp(6rem, 18vw, 12rem);
    height: auto;
    justify-self: end;
  }
</style>
