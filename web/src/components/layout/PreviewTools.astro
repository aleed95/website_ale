---
/**
 * Rendered only on /anteprima/ pages: enables click-to-edit overlays (Sanity Visual
 * Editing) and shows a small "draft preview" badge. Never part of the public site.
 */
---

<p class="preview-badge" role="status">Anteprima · bozze</p>

<script>
  import '@sanity/visual-editing-standalone/styles.css';
  import { enableVisualEditing } from '@sanity/visual-editing-standalone';

  // The Studio signals each saved change of the open document ("mutation") and clicks on
  // its reload button ("manual"). Pages are server-rendered, so a reload shows the new
  // draft; mutations are debounced so typing does not reload on every keystroke.
  let reloadTimer: ReturnType<typeof setTimeout> | undefined;
  const reloadSoon = (delay: number) => {
    clearTimeout(reloadTimer);
    reloadTimer = setTimeout(() => location.reload(), delay);
    return new Promise<void>(() => {});
  };

  enableVisualEditing({
    refresh: (payload) => {
      if (payload.source === 'manual') return reloadSoon(0);
      if (payload.source === 'mutation') return reloadSoon(700);
      return false;
    },
    history: {
      subscribe: (navigate) => {
        const onPopState = () => navigate({ type: 'pop', url: location.href });
        addEventListener('popstate', onPopState);
        return () => removeEventListener('popstate', onPopState);
      },
      update: (update) => {
        if (update.type === 'push' || update.type === 'replace') location.assign(update.url);
        if (update.type === 'pop') history.back();
      },
    },
  });
</script>

<style>
  .preview-badge {
    position: fixed;
    bottom: var(--space-s);
    left: var(--space-s);
    z-index: 50;
    padding: var(--space-3xs) var(--space-s);
    border-radius: var(--radius-pill);
    background-color: var(--color-bg-inverse);
    color: var(--color-text-inverse);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.04em;
    pointer-events: none;
  }
</style>
