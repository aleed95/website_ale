---
/**
 * Links to the current page in the other language. When a translation does not exist
 * (e.g. an article written only in Italian) it links to that language's home page.
 */
import { getRoutePath, localeTags, locales, type Locale } from '@/i18n/config';
import { t } from '@/i18n/ui';

interface Props {
  locale: Locale;
  alternates?: Partial<Record<Locale, string>> | undefined;
  class?: string;
}

const { locale, alternates = {}, class: className } = Astro.props;
const strings = t(locale);
---

<nav class:list={['lang-switcher', className]} aria-label={strings.a11y.languageSwitcher}>
  <ul role="list">
    {
      locales.map((l) => (
        <li>
          {l === locale ? (
            <span class="current" aria-current="true">
              <abbr title={localeTags[l].label}>{l.toUpperCase()}</abbr>
            </span>
          ) : (
            <a href={alternates[l] ?? getRoutePath('home', l)} hreflang={localeTags[l].lang} lang={localeTags[l].lang}>
              <span aria-hidden="true">{l.toUpperCase()}</span>
              <span class="visually-hidden">{localeTags[l].label}</span>
            </a>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<style>
  ul {
    display: flex;
    gap: var(--space-2xs);
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.06em;
  }

  a,
  .current {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    min-width: 2.75rem;
    justify-content: center;
  }

  a {
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  .current abbr {
    text-decoration: none;
    border-bottom: 2px solid var(--color-accent);
  }
</style>
