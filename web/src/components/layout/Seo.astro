---
/**
 * <head> metadata: title, description, canonical, hreflang alternates, Open Graph, Twitter.
 * In phase 2 the values come from each document's SEO fields, falling back to the
 * defaults in Sanity "Site settings".
 */
import { defaultLocale, localeTags, locales, type Locale } from '@/i18n/config';

interface Props {
  title: string;
  siteName: string;
  locale: Locale;
  description?: string | undefined;
  /** Path of this same page in each locale (used for hreflang). */
  alternates?: Partial<Record<Locale, string>> | undefined;
  /** Absolute URL of the share image (1200×630 recommended). */
  image?: string | undefined;
  imageAlt?: string | undefined;
  noindex?: boolean | undefined;
  ogType?: 'website' | 'article' | undefined;
}

const { title, siteName, locale, description, alternates = {}, image, imageAlt, noindex = false, ogType = 'website' } =
  Astro.props;

const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, site).href;
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;

const hreflangLinks = locales
  .filter((l) => alternates[l])
  .map((l) => ({ hreflang: localeTags[l].lang, href: new URL(alternates[l]!, site).href }));
const xDefault = alternates[defaultLocale] ? new URL(alternates[defaultLocale], site).href : undefined;
const ogAlternateLocales = locales.filter((l) => l !== locale && alternates[l]).map((l) => localeTags[l].og);
---

<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

{hreflangLinks.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
{xDefault && hreflangLinks.length > 1 && <link rel="alternate" hreflang="x-default" href={xDefault} />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={fullTitle} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={localeTags[locale].og} />
{ogAlternateLocales.map((og) => <meta property="og:locale:alternate" content={og} />)}
{image && <meta property="og:image" content={image} />}
{image && imageAlt && <meta property="og:image:alt" content={imageAlt} />}

<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
