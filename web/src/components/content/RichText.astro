---
/** Portable Text renderer for biography, articles, projects and pages. */
import { PortableText } from 'astro-portabletext';
import type { TypedObject } from 'astro-portabletext/types';
import PtImage from './PtImage.astro';
import PtLink from './PtLink.astro';
import PtVideo from './PtVideo.astro';

interface Props {
  value: TypedObject[] | null | undefined;
  class?: string;
}

const { value, class: className } = Astro.props;
const components = {
  type: { accessibleImage: PtImage, video: PtVideo },
  mark: { link: PtLink },
};
---

{
  value && value.length > 0 && (
    <div class:list={['rich-text prose', className]}>
      <PortableText value={value} components={components} />
    </div>
  )
}

<style>
  .rich-text :global(h2) {
    margin-top: var(--space-xl);
    font-size: var(--text-2xl);
  }

  .rich-text :global(h3) {
    margin-top: var(--space-l);
  }

  .rich-text :global(ul),
  .rich-text :global(ol) {
    padding-left: 1.25em;
  }

  .rich-text :global(li + li) {
    margin-top: var(--space-3xs);
  }

  .rich-text :global(blockquote) {
    padding-left: var(--space-m);
    border-left: 3px solid var(--color-accent);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--color-heading-alt);
  }
</style>
