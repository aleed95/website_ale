---
/**
 * Responsive image from the Sanity CDN.
 * - srcset in several widths, AVIF/WebP negotiated by the CDN (auto=format)
 * - explicit width/height → no layout shift
 * - lazy by default; pass `priority` for the main image above the fold (LCP)
 * - optional blurred low-quality placeholder while loading
 */
import { hasImage, urlFor, type SanityImageSource } from '@/lib/sanity/image';
import { editAttribute, type EditTarget } from '@/lib/sanity/edit';
import { useSanity } from '@/lib/sanity/fetch';

interface Props {
  image: SanityImageSource | null | undefined;
  /** Rendered width hint for the browser, e.g. "(min-width: 60rem) 50vw, 100vw". */
  sizes?: string | undefined;
  /** Force a crop ratio (width / height). Defaults to the original ratio. */
  aspectRatio?: number | undefined;
  widths?: number[] | undefined;
  priority?: boolean | undefined;
  placeholder?: boolean | undefined;
  class?: string | undefined;
  /** Override the CMS alt text; pass "" for purely decorative images. */
  alt?: string | undefined;
  /** Field to open when the image is clicked in the Studio preview. */
  edit?: EditTarget | undefined;
}

const {
  image,
  sizes = '100vw',
  aspectRatio,
  widths = [400, 640, 960, 1280, 1600, 2000, 2400],
  priority = false,
  placeholder = true,
  class: className,
  alt,
  edit,
} = Astro.props;
const dataSanity = editAttribute(useSanity(Astro.locals).preview, edit);

const source = hasImage(image) ? image : null;
const dimensions = source?.asset.metadata?.dimensions;
const originalWidth = dimensions?.width ?? 2400;
const originalHeight = dimensions?.height ?? 1600;

// The crop chosen in the Studio changes the effective ratio.
const crop = source?.crop;
const croppedRatio =
  (originalWidth * (1 - (crop?.left ?? 0) - (crop?.right ?? 0))) /
  (originalHeight * (1 - (crop?.top ?? 0) - (crop?.bottom ?? 0)));
const ratio = aspectRatio ?? croppedRatio;

// Never upscale: keep widths up to the original size.
const usable = widths.filter((w) => w <= originalWidth);
const candidates = usable.length > 0 ? usable : [originalWidth];

const build = (w: number) => {
  if (!source) return '';
  let url = urlFor(source).width(w).auto('format').quality(75).fit('crop');
  if (aspectRatio) url = url.height(Math.round(w / aspectRatio));
  return url.url();
};

const largest = candidates[candidates.length - 1] ?? originalWidth;
const srcset = candidates.map((w) => `${build(w)} ${w}w`).join(', ');
const src = build(candidates[Math.min(2, candidates.length - 1)] ?? largest);
const lqip = placeholder ? source?.asset.metadata?.lqip : undefined;

// When CSS crops the photo (object-fit: cover, e.g. the home hero), keep the hotspot
// chosen in the Studio in view. Hotspot coordinates refer to the uncropped original.
const hotspot = source?.hotspot;
const focus =
  hotspot?.x != null && hotspot.y != null
    ? (() => {
        const left = crop?.left ?? 0;
        const top = crop?.top ?? 0;
        const clamp = (n: number) => Math.min(100, Math.max(0, n * 100)).toFixed(1);
        const x = (hotspot.x - left) / (1 - left - (crop?.right ?? 0));
        const y = (hotspot.y - top) / (1 - top - (crop?.bottom ?? 0));
        return `${clamp(x)}% ${clamp(y)}%`;
      })()
    : undefined;
const style = [lqip && `background-image: url(${lqip})`, focus && `object-position: ${focus}`].filter(Boolean).join('; ');
const altText = alt ?? source?.alt ?? '';
---

{
  source && (
    <img
      src={src}
      srcset={srcset}
      sizes={sizes}
      width={largest}
      height={Math.round(largest / ratio)}
      alt={altText}
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={priority ? 'high' : 'auto'}
      class:list={['sanity-image', className]}
      style={style || undefined}
      data-sanity={dataSanity}
    />
  )
}

<style>
  .sanity-image {
    width: 100%;
    height: auto;
    background-size: cover;
    background-position: center;
    background-color: var(--color-bg-alt);
  }
</style>
