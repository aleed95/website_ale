---
/**
 * Call-to-action link styled as a button (brand manual p.09: Burnt Caramel with
 * Floral White text).
 *
 * Accessibility: that pair is 3.7:1, which WCAG AA accepts only for "large" text
 * (≥ 18.66px bold). The primary variant therefore uses 19px bold.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'primary' | 'secondary';
}

const { href, variant = 'primary', class: className, ...rest } = Astro.props;
---

<a href={href} class:list={['button', `button--${variant}`, className]} {...rest}>
  <slot />
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    min-height: 3rem;
    padding: var(--space-xs) var(--space-m);
    border: 2px solid transparent;
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    line-height: 1.2;
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .button--primary {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
    font-size: 1.1875rem;
    font-weight: var(--weight-bold);
  }

  .button--primary:hover {
    background-color: color-mix(in srgb, var(--color-accent) 88%, black);
  }

  .button--secondary {
    border-color: var(--color-heading-alt);
    color: var(--color-heading-alt);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
  }

  .button--secondary:hover {
    background-color: var(--color-heading-alt);
    color: var(--color-text-inverse);
  }
</style>
