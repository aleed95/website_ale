---
/**
 * Call to action: a link (`href`) or a form button (no `href`).
 * Brand manual p.09: Burnt Caramel with Floral White text.
 *
 * Accessibility: that pair is 3.7:1, which WCAG AA accepts only for "large" text
 * (≥ 18.66px bold). The primary variant therefore uses 19px bold.
 */
interface Props {
  /** Renders a link when set, otherwise a form button. */
  href?: string | undefined;
  type?: 'submit' | 'button';
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { href, type = 'submit', variant = 'primary', class: className } = Astro.props;
const classes = ['button', `button--${variant}`, className];
---

{
  href ? (
    <a class:list={classes} href={href}>
      <slot />
    </a>
  ) : (
    <button class:list={classes} type={type}>
      <slot />
    </button>
  )
}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    min-height: 3rem;
    padding: var(--space-xs) var(--space-m);
    border: 2px solid transparent;
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .button--primary {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
    font-size: 1.1875rem;
    font-weight: var(--weight-bold);
  }

  .button--primary:hover {
    background-color: color-mix(in srgb, var(--color-accent) 88%, black);
  }

  .button--secondary {
    border-color: var(--color-heading-alt);
    background-color: transparent;
    color: var(--color-heading-alt);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
  }

  .button--secondary:hover {
    background-color: var(--color-heading-alt);
    color: var(--color-text-inverse);
  }
</style>
