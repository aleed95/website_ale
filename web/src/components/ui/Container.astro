---
/** Centred, max-width wrapper with responsive side gutters. */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  as?: 'div' | 'section' | 'article' | 'header' | 'footer';
  width?: 'default' | 'text';
}

const { as: Tag = 'div', width = 'default', class: className, ...rest } = Astro.props;
---

<Tag class:list={['container', `container--${width}`, className]} {...rest}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .container--default {
    max-width: calc(var(--container-max) + 2 * var(--gutter));
  }

  .container--text {
    max-width: calc(var(--container-text) + 2 * var(--gutter));
  }
</style>
