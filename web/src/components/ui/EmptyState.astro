---
import { t } from '@/i18n/ui';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<p class="empty">{t(locale).common.empty}</p>

<style>
  .empty {
    padding: var(--space-l);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-m);
    text-align: center;
  }
</style>
