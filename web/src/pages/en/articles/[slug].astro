---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import ArticleView from '@/views/ArticleView.astro';
import { getArticlePaths } from '@/lib/paths';

export const getStaticPaths = (() => getArticlePaths('en')) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { article } = Astro.props as Props;
---

<ArticleView locale="en" article={article} />
