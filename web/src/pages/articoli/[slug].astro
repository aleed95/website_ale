---
/** Article page, rendered on demand: new articles are online minutes after Publish. */
import ArticleView from '@/views/ArticleView.astro';
import NotFoundView from '@/views/NotFoundView.astro';
import { cacheOnCdn } from '@/lib/live';
import { useSanity } from '@/lib/sanity/fetch';
import { ARTICLE_QUERY } from '@/lib/sanity/queries';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const article = await useSanity(Astro.locals).client.fetch(ARTICLE_QUERY, { language: 'it', slug });
if (article?.slug) cacheOnCdn(Astro.response.headers);
else Astro.response.status = 404;
---

{article?.slug ? <ArticleView locale="it" article={{ ...article, slug: article.slug }} /> : <NotFoundView />}
