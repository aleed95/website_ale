---
/** Project page, rendered on demand: new projects are online minutes after Publish. */
import ProjectView from '@/views/ProjectView.astro';
import NotFoundView from '@/views/NotFoundView.astro';
import { cacheOnCdn } from '@/lib/live';
import { useSanity } from '@/lib/sanity/fetch';
import { PROJECT_QUERY } from '@/lib/sanity/queries';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const project = await useSanity(Astro.locals).client.fetch(PROJECT_QUERY, { language: 'it', slug });
if (project?.slug) cacheOnCdn(Astro.response.headers);
else Astro.response.status = 404;
---

{project?.slug ? <ProjectView locale="it" project={{ ...project, slug: project.slug }} /> : <NotFoundView />}
