# ─────────────────────────────────────────────────────────────
# Sanity Studio — copy to studio/.env for local development.
# Variables prefixed with SANITY_STUDIO_ are bundled into the Studio (browser):
# put ONLY public values here, never tokens.
# ─────────────────────────────────────────────────────────────

# Sanity project ID (sanity.io/manage → project → "Project ID"). Not secret.
SANITY_STUDIO_PROJECT_ID=

# Dataset name. Default: production
SANITY_STUDIO_DATASET=production

# Hostname for `npm run deploy:studio` → https://<hostname>.sanity.studio
# Choose it once; the first deploy registers it.
SANITY_STUDIO_HOSTNAME=

# Website rendering the live preview ("Anteprima" tab). Default: https://alessandrodini.netlify.app
# For local development put http://localhost:4321 in studio/.env.development.
SANITY_STUDIO_PREVIEW_ORIGIN=
